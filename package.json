{
  "name": "npm-run-buttons",
  "displayName": "npm Run Buttons",
  "description": "Run npm scripts and read their live output in the sidebar.",
  "version": "0.2.0",
  "publisher": "0mandrock1",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "repository": { "type": "git", "url": "https://github.com/0mandrock1/npm-run-buttons.git" },
  "main": "./src/extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "npmRunButtons", "title": "npm Scripts", "icon": "media/run.png" }
      ]
    },
    "views": {
      "npmRunButtons": [
        { "id": "npmRunButtons.scripts", "name": "npm Scripts", "type": "webview" }
      ]
    }
  },
  "scripts": {
    "check": "node --check src/extension.js && node --check src/runner.js && node --check media/sidebar.js && node --check media/terminal.js"
  }
}
